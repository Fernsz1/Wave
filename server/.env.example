# Copy to server/.env and fill in real values. .env is gitignored; this template is committed.

# ── Database ──────────────────────────────────────────────────────────────
# Leave unset to use the bundled SQLite (offline/dev default).
# Set to switch the central server to Postgres (requires a running PG instance):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ── MQTT broker (Mosquitto) ───────────────────────────────────────────────
WAVE_BROKER_HOST=127.0.0.1
WAVE_BROKER_PORT=1883

# ── AI (blank = mock/fallback mode; set the key to enable Gemini) ─────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── LoRa egress (Heltec A on the server/town side) ────────────────────────
# Leave LORA_ENABLED=false for the pure-MQTT LAN demo. Set true + LORA_PORT to
# also broadcast every downstream cast over LoRa to the village radio (Pi).
LORA_ENABLED=false
LORA_PORT=                 # COM3 (Windows) or /dev/ttyUSB0 (Linux/Mac)
LORA_BAUD=115200
LORA_TOWN_ADDR=1           # this host's Heltec A address
LORA_VILLAGE_ADDR=2        # destination: Heltec B on the Pi
LORA_NETWORK_ID=18         # must match the Pi's Heltec B
LORA_PARAMETER=10,7,1,7    # SF10, BW125kHz, CR4/5, preamble 7 (must match peer)
